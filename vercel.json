{
  "functions": {
    "api/[...route].js": {
      "includeFiles": "index.html"
    },
    "api/council.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/app"
    },
    {
      "source": "/index.html",
      "destination": "/api/app"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    }
  ]
}

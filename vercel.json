{
  "functions": {
    "api/gateway.js": {
      "includeFiles": "{*.html,*.js,*.mjs,*.css,*.png,assets/**/*.png,workbench/**/*.js,workbench/**/*.mjs,workbench/**/*.css,workbench/**/*.svg}",
      "maxDuration": 120
    }
  },
  "routes": [
    {
      "src": "^/(.*)$",
      "dest": "/api/gateway?path=$1"
    }
  ]
}

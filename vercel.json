{
  "functions": {
    "api/[...route].js": {
      "includeFiles": [
        "index.html",
        "app.js",
        "calendar-test.html",
        "council-test.html"
      ]
    },
    "api/council.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/app"
    },
    {
      "source": "/index.html",
      "destination": "/api/app"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/app.js",
      "destination": "/api/app?asset=app.js"
    },
    {
      "source": "/calendar-test.html",
      "destination": "/api/app?document=calendar-test.html"
    },
    {
      "source": "/council-test.html",
      "destination": "/api/app?document=council-test.html"
    }
  ]
}

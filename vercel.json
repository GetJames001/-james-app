{
  "functions": {
    "api/gateway.js": {
      "includeFiles": "{*.html,*.js,*.mjs,*.css,*.png,assets/**/*.png,assets/orb/*.svg,assets/scenes/*.mp4,assets/scenes/*.jpg,workbench/**/*.js,workbench/**/*.mjs,workbench/**/*.css,workbench/**/*.svg}",
      "maxDuration": 120
    }
  },
  "routes": [
    {
      "src": "^/assets/wake/v1/(vosk-worker-0\\.0\\.8\\.js|vosk-0\\.0\\.8\\.js|english-0\\.15\\.tar\\.gz|LICENSE\\.txt|NOTICE\\.txt|manifest\\.json)$",
      "dest": "/assets/wake/v1/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "X-Content-Type-Options": "nosniff",
        "Content-Security-Policy": "default-src 'none'; connect-src 'self' data:; script-src 'self' 'unsafe-eval'; object-src 'none'; base-uri 'none'"
      }
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/gateway?path=$1"
    }
  ],
  "buildCommand": "node wake-assets-build.cjs",
  "outputDirectory": "public"
}
